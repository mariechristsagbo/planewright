{
  "description": "Desktop dark theme: toggle with Alt+Shift+D, read theme storage and root styles, capture canvas, main menu, properties panel, help and export dialogs. From s6 on, its emulate step is an assertMetrics step and only 00 emulates. In s5 the re-applied override read back the headless default screen (800x600) because the preceding Playwright screenshot had reset the emulated screen metrics; that was later reproduced on a self-authored fixture, and the driver now captures through CDP instead.",
  "continueOnError": true,
  "steps": [
    {
      "do": "assertMetrics",
      "expect": {
        "innerWidth": 1280,
        "innerHeight": 720,
        "devicePixelRatio": 1,
        "screenWidth": 1280,
        "screenHeight": 720,
        "maxTouchPoints": 0,
        "canvasBacking": true
      }
    },
    {
      "do": "click",
      "at": [1150, 650]
    },
    {
      "do": "key",
      "key": "Alt+Shift+d"
    },
    {
      "do": "wait",
      "ms": 800
    },
    {
      "do": "rootStyle"
    },
    {
      "do": "appState",
      "label": "07-dark"
    },
    {
      "do": "storage"
    },
    {
      "do": "wait",
      "ms": 500
    },
    {
      "do": "aria",
      "save": "dark-01-canvas"
    },
    {
      "do": "screenshot",
      "name": "dark-01-canvas"
    },
    {
      "do": "click",
      "at": [34, 34]
    },
    {
      "do": "wait",
      "ms": 500
    },
    {
      "do": "aria",
      "save": "dark-02-main-menu"
    },
    {
      "do": "screenshot",
      "name": "dark-02-main-menu"
    },
    {
      "do": "key",
      "key": "Escape"
    },
    {
      "do": "wait",
      "ms": 300
    },
    {
      "do": "click",
      "at": [430, 300]
    },
    {
      "do": "wait",
      "ms": 500
    },
    {
      "do": "aria",
      "save": "dark-03-props-panel"
    },
    {
      "do": "screenshot",
      "name": "dark-03-props-panel"
    },
    {
      "do": "key",
      "key": "Escape"
    },
    {
      "do": "wait",
      "ms": 300
    },
    {
      "do": "click",
      "at": [1150, 650]
    },
    {
      "do": "key",
      "key": "?"
    },
    {
      "do": "wait",
      "ms": 500
    },
    {
      "do": "aria",
      "save": "dark-04-help"
    },
    {
      "do": "screenshot",
      "name": "dark-04-help"
    },
    {
      "do": "key",
      "key": "Escape"
    },
    {
      "do": "wait",
      "ms": 300
    },
    {
      "do": "click",
      "at": [1150, 650]
    },
    {
      "do": "key",
      "key": "Control+Shift+e"
    },
    {
      "do": "wait",
      "ms": 500
    },
    {
      "do": "aria",
      "save": "dark-05-export"
    },
    {
      "do": "screenshot",
      "name": "dark-05-export"
    },
    {
      "do": "key",
      "key": "Escape"
    },
    {
      "do": "wait",
      "ms": 300
    },
    {
      "do": "click",
      "at": [1150, 650]
    },
    {
      "do": "wait",
      "ms": 500
    },
    {
      "do": "screenshot",
      "name": "dark-06-idle-for-rea"
    }
  ]
}
