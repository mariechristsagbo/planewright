# Copy to `.env` at the repository root for local development. Never commit `.env`.
# Every value is optional; the defaults below are what the services use when unset.

# Collaboration service (apps/collab)
PLANEWRIGHT_COLLAB_HOST=127.0.0.1
PLANEWRIGHT_COLLAB_PORT=8787
# Comma-separated list of browser origins allowed to open WebSocket connections.
PLANEWRIGHT_COLLAB_ALLOWED_ORIGINS=http://localhost:5173
# Maximum accepted WebSocket message size in bytes.
PLANEWRIGHT_COLLAB_MAX_PAYLOAD_BYTES=65536
