    "build": "node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@planewright/protocol": "0.0.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2"
  }
}
