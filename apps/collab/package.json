{
  "name": "@planewright/collab",
  "version": "0.0.0",
  "private": true,
  "description": "Autonomous Node.js WebSocket collaboration service for Planewright (foundation only).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/main.ts",
